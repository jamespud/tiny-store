<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender with enhanced pattern including MDC fields -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Pattern includes correlationId, requestId, and idempotencyKey from MDC -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [correlationId=%X{correlationId:-N/A}]
                [requestId=%X{requestId:-N/A}] [idempotencyKey=%X{idempotencyKey:-N/A}] - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- File appender with JSON format for structured logging -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/order-service.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/order-service.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- JSON structured logging with MDC fields -->
            <includeContext>true</includeContext>
            <includeMdc>true</includeMdc>
            <customFields>{"service":"order-service"}</customFields>
        </encoder>
    </appender>

    <!-- Specific logger for idempotency operations -->
    <logger name="com.github.spud.tinystore.order.interfaces.util.IdempotencyHelper" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Specific logger for order controllers -->
    <logger name="com.github.spud.tinystore.order.interfaces.rest" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </logger>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>