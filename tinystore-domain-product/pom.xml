<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.github.spud.tinystore</groupId>
		<artifactId>tiny-store</artifactId>
		<version>1.0-SNAPSHOT</version>
	</parent>

	<artifactId>tinystore-domain-product</artifactId>
	<description>
		负责商品基础信息（名称、图片）、SKU 管理（规格、库存）、类目体系，支持多规格（如颜色、尺寸）与动态属性（如直播专属价）
	</description>

	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
	</properties>

	<dependencies>
		<!-- internal infrastructure (redis, security, etc.) -->
		<dependency>
			<groupId>com.github.spud.tinystore</groupId>
			<artifactId>tinystore-library-infrastructure</artifactId>
			<version>1.0-SNAPSHOT</version>
		</dependency>

		<!-- spring basics for application layer wiring (no DB/Kafka here yet) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<!-- bean validation annotations -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- lombok for concise domain models -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.assertj</groupId>
			<artifactId>assertj-core</artifactId>
			<version>3.26.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

</project>