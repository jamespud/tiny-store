<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.github.spud.tinystore</groupId>
        <artifactId>tiny-store</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>tinystore-tests-api</artifactId>
    <name>TinyStore API Tests</name>
    <description>End-to-end API tests for TinyStore gateway and services</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Single-instance defaults (match docker-compose-test.yml). Every value below can be
          overridden with -D on the Maven command line; `make e2e-multi` overrides the replica
          URL lists with one entry per replica so the distributed assertions scale with
          MULTI_REPLICAS instead of assuming exactly two replicas.
        -->
        <gateway.base.url>http://localhost:8080</gateway.base.url>
        <product.base.url>http://localhost:8090</product.base.url>
        <inventory.base.url>http://localhost:13000</inventory.base.url>
        <promotion.base.url>http://localhost:1200</promotion.base.url>
        <multi.instance.mode>false</multi.instance.mode>
        <multi.instance.replicas>2</multi.instance.replicas>
        <nacos.base.url>http://localhost:8849</nacos.base.url>
        <gateway.replica.urls>http://localhost:38080</gateway.replica.urls>
        <order.replica.urls>http://localhost:38280</order.replica.urls>
        <POSTGRES_URL>jdbc:postgresql://localhost:5433/tinystore</POSTGRES_URL>
    </properties>

    <dependencies>
        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- Spring Web for RestClient -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ for fluent assertions -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility for async verification -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Direct PostgreSQL access for E2E seed fixture & strong DB assertions -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <gateway.base.url>${gateway.base.url}</gateway.base.url>
                        <product.base.url>${product.base.url}</product.base.url>
                        <inventory.base.url>${inventory.base.url}</inventory.base.url>
                        <promotion.base.url>${promotion.base.url}</promotion.base.url>
                        <multi.instance.mode>${multi.instance.mode}</multi.instance.mode>
                        <multi.instance.replicas>${multi.instance.replicas}</multi.instance.replicas>
                        <nacos.base.url>${nacos.base.url}</nacos.base.url>
                        <gateway.replica.urls>${gateway.replica.urls}</gateway.replica.urls>
                        <order.replica.urls>${order.replica.urls}</order.replica.urls>
                        <POSTGRES_URL>${POSTGRES_URL}</POSTGRES_URL>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <failIfNoTests>true</failIfNoTests>
                    <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                    <systemPropertyVariables>
                        <gateway.base.url>${gateway.base.url}</gateway.base.url>
                        <product.base.url>${product.base.url}</product.base.url>
                        <inventory.base.url>${inventory.base.url}</inventory.base.url>
                        <promotion.base.url>${promotion.base.url}</promotion.base.url>
                        <multi.instance.mode>${multi.instance.mode}</multi.instance.mode>
                        <multi.instance.replicas>${multi.instance.replicas}</multi.instance.replicas>
                        <nacos.base.url>${nacos.base.url}</nacos.base.url>
                        <gateway.replica.urls>${gateway.replica.urls}</gateway.replica.urls>
                        <order.replica.urls>${order.replica.urls}</order.replica.urls>
                        <POSTGRES_URL>${POSTGRES_URL}</POSTGRES_URL>
                    </systemPropertyVariables>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
